# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# (Server/admin only, never expose in the client bundle)
SUPABASE_PROJ_NAME=your-project-name
SUPABASE_PROJ_PWD=your-db-password

# ── Backend selector ──────────────────────────────────────
# Which Supabase the app talks to: `local` (Docker stack on this machine) or
# `remote` (the hosted project above). Unset means local in dev, remote in a
# production build. Start the local stack with `npm run db:start`, rebuild it
# from migrations + seed with `npm run db:reset`.
# See docs/DATABASE.md.
VITE_BACKEND=local

# Local stack credentials. These are the fixed demo values the Supabase CLI
# issues for every local install, so they are the same on every machine and
# grant nothing outside it. Leave them as is unless you changed the CLI ports.
VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
VITE_SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ── Gemini (optional AI features) ─────────────────────────
VITE_GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key

# ── DiceBear avatars ──────────────────────────────────────
# Base URL of the DiceBear HTTP API (self-host or public).
VITE_DICEBEAR_BASE_URL=https://api.dicebear.com
# Default avatar style: shapes | identicon | rings | thumbs | bottts | glass | initials
VITE_DICEBEAR_STYLE=shapes

# ── Zoom (in-app meetings) ────────────────────────────────
# Meeting SDK app (embed meetings in the browser; secret is server-only,
# used by /api/zoom-signature to sign join tokens).
VITE_ZOOM_MEETING_CLIENT_ID=your-meeting-sdk-client-id
ZOOM_MEETING_CLIENT_SECRET=your-meeting-sdk-client-secret
# Server-to-Server OAuth app (create/update/delete meetings via REST,
# used by /api/zoom-meetings; needs the meeting:write:admin scope).
ZOOM_S2S_ACCOUNT_ID=your-s2s-account-id
ZOOM_S2S_CLIENT_ID=your-s2s-client-id
ZOOM_S2S_CLIENT_SECRET=your-s2s-client-secret

# ── Stripe (parent billing) ───────────────────────────────
# Test-mode secret key (server-only). Hosted Checkout needs no client key.
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret. Locally: `stripe listen --forward-to
# localhost:3001/api/stripe-webhook` prints a whsec_… ; paste it here.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# Supabase service-role key (server-only!). The webhook uses it to mark
# invoices paid past RLS. Never expose this in the client bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Base URL used for Checkout success/cancel redirects.
APP_BASE_URL=http://localhost:5173

# ── Deprecated in V1 (Jitsi SDK removed) ──────────────────
# VITE_JAAS_APP_ID=
