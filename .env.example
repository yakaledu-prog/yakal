# Copy to .env and fill in. Add every new key here too, with a placeholder.
# VITE_ values are compiled into the bundle and are public. Nothing else is.

# -- Backend: local (Docker stack) or remote (hosted) --
VITE_BACKEND=local

# -- Supabase, hosted: Project Settings > API --
VITE_SUPABASE_URL=https://yourprojectref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Bypasses row level security. Server side only, never VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -- Supabase, local: the CLI's fixed demo values, same on every machine --
VITE_SUPABASE_LOCAL_URL=http://127.0.0.1:54321
VITE_SUPABASE_LOCAL_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# -- Zoom Meeting SDK: joins meetings in the browser --
VITE_ZOOM_MEETING_CLIENT_ID=your-meeting-sdk-client-id
ZOOM_MEETING_CLIENT_SECRET=your-meeting-sdk-client-secret

# -- Zoom Server to Server OAuth: creates meetings. Needs meeting:write:admin --
ZOOM_S2S_ACCOUNT_ID=your-s2s-account-id
ZOOM_S2S_CLIENT_ID=your-s2s-client-id
ZOOM_S2S_CLIENT_SECRET=your-s2s-client-secret

# -- Stripe --
STRIPE_SECRET_KEY=sk_test_your-secret-key
# From `stripe listen --forward-to localhost:3001/api/stripe-webhook`.
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
# -- The public origin. Stripe and Connect redirects fall back to the request
# -- host when this is unset, but links inside emails do not: they are sent to
# -- somebody who did not make the request, so an unset value there is a dead
# -- localhost link. Set it in production --
APP_BASE_URL=http://localhost:5173

# -- Booking --
# The Calendly the landing page opens. Without it the build falls back to the
# developer account it was written against.
# -- Development shortcuts --
# "true" opens /preview/*, the /dev console, and the one-click demo logins on
# the sign-in page. Those accounts use demo123, which is in this repository,
# so only set it where that is acceptable. Absent means off.
VITE_DEV_PREVIEW=false

VITE_BOOKING_URL=https://calendly.com/your-account/parent-counseling-session

# -- What the footer prints --
VITE_CONTACT_EMAIL=hello@yakal.me
VITE_CONTACT_PHONE=+1 (123) 456-7890
VITE_CONTACT_ADDRESS=123 Design Street, New York, United States

# -- Google: one OAuth client for Drive, Classroom and /api/google-token --
VITE_GCP_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GCP_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token

# -- Email --
RESEND_API_KEY=re_your-resend-key
VITE_CONTACT_DESTINATION_EMAIL=hello@yourdomain.com

# -- AI support chat: server side only, never VITE_ --
GROQ_API_KEY=gsk_your-groq-key

# -- Cloudinary: unsigned uploads, so no secret --
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-preset

# -- Avatars: shapes | identicon | rings | thumbs | bottts | initials --
VITE_DICEBEAR_BASE_URL=https://api.dicebear.com
VITE_DICEBEAR_STYLE=shapes

# -- The From address on every email. Must be on a domain verified in Resend.
# -- Left blank it falls back to onboarding@resend.dev, Resend's sandbox
# -- sender, which only ever delivers to the Resend account owner --
EMAIL_FROM=Yakal Education Services <noreply@yakal.me>

# -- Gemini: the landing page assistant, and seed generation --
GEMINI_API_KEY=your-gemini-key
# Which model answers visitors. Blank uses gemini-3.5-flash-lite, measured at
# ~780ms to first token. gemma-4-26b-a4b-it also works but thinks before every
# answer and cannot be told not to, which measured ~6.8s with nothing streamed
# until the end. Fine for the chat panel, unusable for voice.
GEMINI_MODEL=

# -- Enables /api/dev-user for the /dev console. Production refuses regardless --
DEV_TOOLS_ENABLED=false
