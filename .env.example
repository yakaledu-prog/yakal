# ── Supabase ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# (Server/admin only, never expose in the client bundle)
SUPABASE_PROJ_NAME=your-project-name
SUPABASE_PROJ_PWD=your-db-password

# ── Gemini (optional AI features) ─────────────────────────
VITE_GEMINI_API_KEY=your-gemini-key
GEMINI_API_KEY=your-gemini-key

# ── DiceBear avatars ──────────────────────────────────────
# Base URL of the DiceBear HTTP API (self-host or public).
VITE_DICEBEAR_BASE_URL=https://api.dicebear.com
# Default avatar style: shapes | identicon | rings | thumbs | bottts | glass | initials
VITE_DICEBEAR_STYLE=shapes

# ── Zoom (in-app meetings) ────────────────────────────────
# Meeting SDK app (embed meetings in the browser; secret is server-only,
# used by /api/zoom-signature to sign join tokens).
VITE_ZOOM_MEETING_CLIENT_ID=your-meeting-sdk-client-id
ZOOM_MEETING_CLIENT_SECRET=your-meeting-sdk-client-secret
# Server-to-Server OAuth app (create/update/delete meetings via REST,
# used by /api/zoom-meetings; needs the meeting:write:admin scope).
ZOOM_S2S_ACCOUNT_ID=your-s2s-account-id
ZOOM_S2S_CLIENT_ID=your-s2s-client-id
ZOOM_S2S_CLIENT_SECRET=your-s2s-client-secret

# ── Deprecated in V1 (Jitsi SDK removed) ──────────────────
# VITE_JAAS_APP_ID=
