# Dependencies
node_modules/

# Build output
dist/
dist-ssr/

# Vercel
.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Secrets and environment
# .env holds live credentials for both the hosted project and the local stack.
# Only the example is committed.
.env
.env.*
!.env.example
google-credentials.json
service-account*.json

# Personal working files. One folder for notes, scratch work and anything else
# that should not leave this machine. See .local/README.md.
.local/
*.local
# A top level notes/ keeps reappearing from the editor; it belongs in .local/.
notes/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.claude/
.DS_Store
Thumbs.db

# Local database snapshots taken around a db reset.
.snapshots/
dev-dist/

# Windows marks files downloaded from the internet with an alternate data
# stream, which WSL surfaces as a companion file. Nine of them were committed
# alongside the landing page images.
*:Zone.Identifier
.DS_Store
Thumbs.db
desktop.ini
