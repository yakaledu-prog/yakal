{
  "name": "yakal",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Yakal - personalized tutoring for students who want to excel.",
  "postinstall": "react-flagpack",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch scripts/local-api.ts\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "optimize:images": "node scripts/optimize-images.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:migrate": "supabase migration up",
    "db:new": "supabase migration new",
    "db:diff": "supabase db diff -f",
    "db:status": "supabase status",
    "db:studio": "echo 'Supabase Studio: http://localhost:54323' && echo 'Mailpit (outgoing email): http://localhost:54324'",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:fresh": "tsx scripts/seed.ts --fresh",
    "db:seed:remote": "tsx scripts/seed.ts --target=remote",
    "db:push:remote": "supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "demo": "tsx scripts/demo.ts",
    "verify": "tsx scripts/verify/run-all.mjs",
    "db:snapshot": "tsx scripts/snapshot.ts save",
    "db:restore": "tsx scripts/snapshot.ts restore",
    "seed:generate": "tsx scripts/seed/generate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1085.0",
    "@aws-sdk/s3-request-presigner": "^3.1085.0",
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource/apfel-grotezk": "^5.2.5",
    "@fullcalendar/core": "^6.1.21",
    "@jitsi/react-sdk": "^1.4.4",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-popover": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "@react-oauth/google": "^0.13.5",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "@tiptap/extension-placeholder": "^3.29.0",
    "@tiptap/extension-underline": "^3.27.4",
    "@tiptap/react": "^3.29.0",
    "@tiptap/starter-kit": "^3.29.0",
    "@types/nodemailer": "^8.0.1",
    "@zoom/meetingsdk": "^6.2.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "emoji-picker-react": "^4.19.1",
    "googleapis": "^173.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "0.487.0",
    "nodemailer": "^9.0.3",
    "react": "18.3.1",
    "react-audio-visualize": "^1.2.0",
    "react-dom": "18.3.1",
    "react-flagpack": "^2.0.6",
    "react-hook-form": "^7.80.0",
    "react-is": "^19.2.7",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.9.0",
    "resend": "^6.17.2",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.3.8",
    "wavesurfer.js": "^7.12.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.9.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vercel/node": "^5.8.22",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "playwright": "^1.62.1",
    "sharp": "^0.34.5",
    "supabase": "^2.110.0",
    "tailwindcss": "4.1.12",
    "tsx": "^4.22.4",
    "typescript": "~5.6.0",
    "vite": "^6.4.3"
  }
}
